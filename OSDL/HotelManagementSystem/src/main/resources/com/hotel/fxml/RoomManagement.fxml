<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!--
    RoomManagement.fxml — Room CRUD screen (Enhanced).
    Layout: BorderPane wrapping a GridPane form + amenity checkboxes + TableView + detail panel.
    Components: TextField, ComboBox, CheckBox, Button, TableView, ImageView (Week 9 requirement).
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.controller.RoomManagementController"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0a1a, #121230, #0d1f3c);">

    <!-- ═══ TOP: Header ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 0 0 15 15;">
            <padding><Insets topRightBottomLeft="14"/></padding>



            <Label text="🛏  Room Management"
                   style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font size="22"/></font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search Bar -->
            <TextField fx:id="txtSearch" promptText="🔍 Search rooms..."
                       prefWidth="250"
                       style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 10; -fx-font-size: 13;"/>
        </HBox>
    </top>

    <!-- ═══ LEFT: Data Entry Form + Amenities ═══ -->
    <left>
        <ScrollPane fitToWidth="true" prefWidth="310"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="12" prefWidth="290"
                  style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 15;">
                <padding><Insets top="16" right="14" bottom="16" left="14"/></padding>

                <Label text="Add / Edit Room"
                       style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

                <GridPane hgap="8" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="38"/>
                        <ColumnConstraints percentWidth="62"/>
                    </columnConstraints>

                    <!-- Row 0: Room Number -->
                    <Label text="Room No:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtRoomNumber" promptText="e.g. 101"
                               style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-font-size: 12;"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <!-- Row 1: Room Type -->
                    <Label text="Type:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbRoomType" promptText="Select Type"
                              prefWidth="170"
                              style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-font-size: 12;"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <!-- Row 2: Price Per Night -->
                    <Label text="Price/Night:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtPrice" promptText="₹ auto-filled"
                               style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-font-size: 12;"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <!-- Row 3: Max Occupancy -->
                    <Label text="Max Guests:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtMaxOccupancy" promptText="auto-filled"
                               style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-font-size: 12;"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>

                <!-- Default Amenities Label -->
                <Label fx:id="lblDefaultAmenities" text=""
                       style="-fx-text-fill: #7a7aaa; -fx-font-size: 11; -fx-wrap-text: true;"
                       wrapText="true"/>

                <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

                <!-- ── Extra Amenities (Checkboxes) ── -->
                <Label text="Extra Amenities"
                       style="-fx-text-fill: #00d2ff; -fx-font-size: 13; -fx-font-weight: bold;"/>

                <GridPane hgap="6" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <CheckBox fx:id="chkPool" text="Pool"
                              style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                              GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <CheckBox fx:id="chkGym" text="Gym"
                              style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <CheckBox fx:id="chkSpa" text="Spa"
                              style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                              GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <CheckBox fx:id="chkMinibar" text="Minibar"
                              style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <CheckBox fx:id="chkBalcony" text="Balcony"
                              style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                              GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <CheckBox fx:id="chkRoomService" text="Room Service"
                              style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <CheckBox fx:id="chkParking" text="Parking"
                              style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                              GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <CheckBox fx:id="chkBreakfast" text="Breakfast"
                              style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                              GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>

                <!-- Custom Amenity -->
                <Label text="Custom Amenity"
                       style="-fx-text-fill: #a0a0c0; -fx-font-size: 11;"/>
                <HBox spacing="6">
                    <TextField fx:id="txtCustomAmenity" promptText="e.g. Jacuzzi, Garden"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-font-size: 11;"/>
                </HBox>

                <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

                <!-- Action Buttons -->
                <HBox spacing="8" alignment="CENTER">
                    <Button fx:id="btnAddRoom" text="➕ Add Room"
                            onAction="#handleAddRoom"
                            prefWidth="125" prefHeight="34"
                            style="-fx-background-color: #00e676; -fx-text-fill: #0a0a1a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12;"/>
                    <Button fx:id="btnDeleteRoom" text="🗑 Delete"
                            onAction="#handleDeleteRoom"
                            prefWidth="125" prefHeight="34"
                            style="-fx-background-color: #ff5252; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12;"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER">
                    <Button fx:id="btnSortByPrice" text="⬆ Sort Price"
                            onAction="#handleSortByPrice"
                            prefWidth="125" prefHeight="30"
                            style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: #00d2ff; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #00d2ff; -fx-border-radius: 8; -fx-font-size: 11;"/>
                    <Button fx:id="btnSortByType" text="⬆ Sort Type"
                            onAction="#handleSortByType"
                            prefWidth="125" prefHeight="30"
                            style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: #ffc107; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #ffc107; -fx-border-radius: 8; -fx-font-size: 11;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- ═══ CENTER: Room Table ═══ -->
    <center>
        <VBox spacing="10">
            <padding><Insets top="12" right="10" bottom="12" left="10"/></padding>

            <Label text="All Rooms"
                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

            <TableView fx:id="tblRooms" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: transparent;">

                <columns>
                    <TableColumn fx:id="colRoomNumber" text="Room #" prefWidth="65">
                        <cellValueFactory><PropertyValueFactory property="roomNumber"/></cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colRoomType" text="Type" prefWidth="95">
                        <cellValueFactory><PropertyValueFactory property="roomType"/></cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colPrice" text="₹/Night" prefWidth="85">
                        <cellValueFactory><PropertyValueFactory property="pricePerNight"/></cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colOccupancy" text="Max" prefWidth="45">
                        <cellValueFactory><PropertyValueFactory property="maxOccupancy"/></cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colAvailable" text="Avail" prefWidth="55">
                        <cellValueFactory><PropertyValueFactory property="isAvailable"/></cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colAmenities" text="Amenities" prefWidth="220">
                        <cellValueFactory><PropertyValueFactory property="amenities"/></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- ═══ RIGHT: Room Detail Panel ═══ -->
    <right>
        <VBox spacing="12" prefWidth="280"
              style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 15;">
            <padding><Insets top="16" right="14" bottom="16" left="14"/></padding>

            <Label text="Room Detail"
                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

            <!-- Room Image Preview -->
            <VBox alignment="CENTER"
                  style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 10;"
                  prefHeight="160">
                <padding><Insets topRightBottomLeft="8"/></padding>
                <ImageView fx:id="imgRoomPreview" fitWidth="250" fitHeight="150" preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"/>
                <Label text="📷 Select a room to preview"
                       style="-fx-text-fill: #555; -fx-font-size: 11;"/>
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

            <Label fx:id="lblDetailType" text="—"
                   style="-fx-text-fill: #00d2ff; -fx-font-size: 18; -fx-font-weight: bold;"/>

            <Label fx:id="lblDetailDescription" text="Select a room to view details"
                   style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                   wrapText="true"/>

            <Label fx:id="lblDetailPrice" text="₹ —"
                   style="-fx-text-fill: #00e676; -fx-font-size: 16; -fx-font-weight: bold;"/>

            <Label fx:id="lblDetailOccupancy" text=""
                   style="-fx-text-fill: #ce93d8; -fx-font-size: 12;"/>

            <Label fx:id="lblDetailStatus" text=""
                   style="-fx-text-fill: #ffc107; -fx-font-size: 14; -fx-font-weight: bold;"/>

            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

            <Label text="Amenities:"
                   style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"/>
            <Label fx:id="lblDetailAmenities" text=""
                   style="-fx-text-fill: #c0c0d0; -fx-font-size: 11;"
                   wrapText="true"/>
        </VBox>
    </right>
</BorderPane>
