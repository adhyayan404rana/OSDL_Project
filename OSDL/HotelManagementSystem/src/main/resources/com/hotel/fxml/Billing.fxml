<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!--
    Billing.fxml — Customer checkout and invoice screen (Enhanced).
    Layout: VBox-based with 3-column body (Week 9 requirement — varied layouts).
    Features: Customer form, room image preview, discount code, bill summary.
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.controller.BillingController"
      spacing="0"
      style="-fx-background-color: linear-gradient(to bottom right, #0a0a1a, #121230, #0d1f3c);">

    <!-- ═══ HEADER ═══ -->
    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 0 0 15 15;">
        <padding><Insets topRightBottomLeft="14"/></padding>



        <Label text="💰  Billing &amp; Checkout"
               style="-fx-text-fill: white; -fx-font-weight: bold;">
            <font><Font size="22"/></font>
        </Label>
    </HBox>

    <!-- ═══ BODY: Three-column layout ═══ -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

        <!-- LEFT COLUMN: Customer & Booking Info -->
        <VBox spacing="14" prefWidth="360"
              style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 15;">
            <padding><Insets topRightBottomLeft="18"/></padding>

            <Label text="Customer &amp; Booking Details"
                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="35"/>
                    <ColumnConstraints percentWidth="65"/>
                </columnConstraints>

                <!-- Customer ID -->
                <Label text="Customer ID:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCustomerId" promptText="e.g. 1001"
                           style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-font-size: 12;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <!-- Customer Name -->
                <Label text="Name:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtCustomerName" promptText="Full name"
                           style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-font-size: 12;"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <!-- Phone -->
                <Label text="Phone:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtPhone" promptText="10-digit number"
                           style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-font-size: 12;"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <!-- Room Selection -->
                <Label text="Room:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="cmbRoom" promptText="Select Room"
                          prefWidth="220"
                          style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-font-size: 11;"
                          GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <!-- Check-in Date -->
                <Label text="Check-In:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                       GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <DatePicker fx:id="dpCheckIn" promptText="Select date"
                            prefWidth="220"
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-font-size: 11;"
                            GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <!-- Check-out Date -->
                <Label text="Check-Out:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                       GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <DatePicker fx:id="dpCheckOut" promptText="Select date"
                            prefWidth="220"
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-font-size: 11;"
                            GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <!-- Discount Code -->
                <Label text="Promo Code:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 12;"
                       GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="txtDiscountCode" promptText="e.g. WELCOME10"
                           style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #00e676; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-font-size: 12;"
                           GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            </GridPane>

            <!-- Room Image Preview -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 10;"
                  prefHeight="140">
                <padding><Insets topRightBottomLeft="8"/></padding>
                <ImageView fx:id="imgRoomBilling" fitWidth="240" fitHeight="130" preserveRatio="true"/>
                <Label text="Select a room to see preview"
                       style="-fx-text-fill: #555; -fx-font-size: 10;"/>
            </VBox>

            <!-- Room Amenities -->
            <Label fx:id="lblRoomAmenities" text=""
                   style="-fx-text-fill: #7a7aaa; -fx-font-size: 11;"
                   wrapText="true"/>

            <!-- Action Buttons -->
            <HBox spacing="12" alignment="CENTER">
                <Button fx:id="btnCalculate" text="🧮  Calculate Bill"
                        onAction="#handleCalculate"
                        prefWidth="155" prefHeight="38"
                        style="-fx-background-color: #00d2ff; -fx-text-fill: #0a0a1a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12;"/>
                <Button fx:id="btnGenerateInvoice" text="📄  Generate Invoice"
                        onAction="#handleGenerateInvoice"
                        prefWidth="155" prefHeight="38"
                        style="-fx-background-color: #00e676; -fx-text-fill: #0a0a1a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12;"/>
            </HBox>
        </VBox>

        <!-- RIGHT COLUMN: Bill Summary -->
        <VBox spacing="14" HBox.hgrow="ALWAYS"
              style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 15;">
            <padding><Insets topRightBottomLeft="22"/></padding>

            <Label text="📋  Bill Summary"
                   style="-fx-text-fill: white; -fx-font-size: 17; -fx-font-weight: bold;"/>

            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

            <GridPane hgap="15" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="55"/>
                    <ColumnConstraints percentWidth="45"/>
                </columnConstraints>

                <Label text="Room Type:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblRoomType" text="—"
                       style="-fx-text-fill: white; -fx-font-size: 14;"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Base Tariff / Night:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblTariff" text="₹ —"
                       style="-fx-text-fill: white; -fx-font-size: 14;"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Total Nights:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="lblNights" text="—"
                       style="-fx-text-fill: white; -fx-font-size: 14;"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Subtotal:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"
                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label fx:id="lblSubtotal" text="₹ —"
                       style="-fx-text-fill: white; -fx-font-size: 14;"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Service Charge (10%):" style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"
                       GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Label fx:id="lblServiceCharge" text="₹ —"
                       style="-fx-text-fill: white; -fx-font-size: 14;"
                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Tax (12% GST):" style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"
                       GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <Label fx:id="lblTax" text="₹ —"
                       style="-fx-text-fill: white; -fx-font-size: 14;"
                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Discount:" style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"
                       GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <Label fx:id="lblDiscount" text="₹ 0.00"
                       style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"
                       GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            </GridPane>

            <Separator style="-fx-background-color: rgba(255,255,255,0.2);"/>

            <!-- Grand Total -->
            <HBox alignment="CENTER" spacing="15"
                  style="-fx-background-color: rgba(0,210,255,0.08); -fx-background-radius: 10;">
                <padding><Insets topRightBottomLeft="15"/></padding>
                <Label text="GRAND TOTAL:"
                       style="-fx-text-fill: #00d2ff; -fx-font-size: 20; -fx-font-weight: bold;"/>
                <Label fx:id="lblGrandTotal" text="₹ 0.00"
                       style="-fx-text-fill: #00e676; -fx-font-size: 24; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Discount Codes Info -->
            <VBox spacing="4"
                  style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 8;">
                <padding><Insets topRightBottomLeft="10"/></padding>
                <Label text="🏷 Available Promo Codes:"
                       style="-fx-text-fill: #7a7aaa; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <Label text="WELCOME10 (10%)  •  SUMMER20 (20%)  •  LOYALTY15 (15%)"
                       style="-fx-text-fill: #555; -fx-font-size: 10;"/>
                <Label text="FIRST25 (25%)  •  WEEKEND5 (5%)"
                       style="-fx-text-fill: #555; -fx-font-size: 10;"/>
            </VBox>

            <!-- Status Message -->
            <Label fx:id="lblStatus" text=""
                   style="-fx-text-fill: #ffc107; -fx-font-size: 12;"
                   wrapText="true"/>
        </VBox>
    </HBox>
</VBox>
