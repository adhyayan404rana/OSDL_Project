<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.controller.LoginController"
      style="-fx-background-color: linear-gradient(to bottom right, #0a0a1a, #121230, #0d1f3c);">

    <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>

    <!-- Login Box -->
    <VBox alignment="CENTER" spacing="25" maxWidth="350"
          style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-border-color: rgba(0,210,255,0.2); -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, 10);">
        
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="5">
            <Label text="🏨" style="-fx-font-size: 40;"/>
            <Label text="System Login" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>
            <Label text="Hotel Management Enterprise" style="-fx-text-fill: #8888aa; -fx-font-size: 11;"/>
        </VBox>

        <!-- Fields -->
        <VBox spacing="15" prefWidth="250">
            <VBox spacing="5">
                <Label text="USERNAME" style="-fx-text-fill: #a0a0c0; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <TextField fx:id="txtUsername" promptText="Enter username"
                           style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-padding: 10;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="PASSWORD" style="-fx-text-fill: #a0a0c0; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <PasswordField fx:id="txtPassword" promptText="Enter password"
                               style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-background-radius: 8; -fx-padding: 10;"/>
            </VBox>
        </VBox>

        <!-- Buttons -->
        <VBox spacing="10" prefWidth="250">
            <Button text="Login to System" onAction="#handleLogin" maxWidth="Infinity"
                    style="-fx-background-color: #00d2ff; -fx-text-fill: #0a0a1a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
            <Button text="Exit Application" onAction="#handleExit" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #8888aa; -fx-border-color: #555; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
        </VBox>

        <!-- Hint -->
        <Label text="Try: admin / admin123" style="-fx-text-fill: #555; -fx-font-size: 10;"/>

    </VBox>
</VBox>
