<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.controller.HousekeepingController"
      style="-fx-background-color: linear-gradient(to bottom right, #0a0a1a, #121230, #0d1f3c);">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="🧹  Housekeeping Module" style="-fx-text-fill: white; -fx-font-weight: bold;">
            <font><Font size="26"/></font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Manage occupied and maintenance rooms" style="-fx-text-fill: #a0a0c0; -fx-font-size: 14;"/>
    </HBox>

    <!-- Table Section -->
    <VBox spacing="10" VBox.vgrow="ALWAYS"
          style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 12;">
        
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

        <TableView fx:id="tblHousekeeping" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colRoomNumber" text="Room Number" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="roomNumber"/></cellValueFactory>
                </TableColumn>

                <TableColumn fx:id="colRoomType" text="Room Type" prefWidth="200">
                    <cellValueFactory><PropertyValueFactory property="roomType"/></cellValueFactory>
                </TableColumn>

                <TableColumn fx:id="colStatus" text="Current Status" prefWidth="200">
                    <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <!-- Actions -->
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="🛠  Mark as Maintenance" onAction="#handleMarkMaintenance"
                    style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            
            <Button text="✨  Mark as Clean (AVAILABLE)" onAction="#handleMarkClean"
                    style="-fx-background-color: #00e676; -fx-text-fill: #0a0a1a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>
