<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.controller.ReservationController"
      style="-fx-background-color: linear-gradient(to bottom right, #0a0a1a, #121230, #0d1f3c);">

    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

    <!-- LEFT: Form -->
    <VBox spacing="15" prefWidth="320"
          style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 12; -fx-border-color: rgba(0,210,255,0.2); -fx-border-radius: 12;">
        
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label text="📅 New Reservation" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>

        <VBox spacing="5">
            <Label text="Guest Name" style="-fx-text-fill: #a0a0c0; -fx-font-size: 11;"/>
            <TextField fx:id="txtGuestName" promptText="Enter full name" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Phone Number" style="-fx-text-fill: #a0a0c0; -fx-font-size: 11;"/>
            <TextField fx:id="txtPhone" promptText="Enter phone number" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Select Room" style="-fx-text-fill: #a0a0c0; -fx-font-size: 11;"/>
            <ComboBox fx:id="cmbRoom" promptText="Choose a room" maxWidth="Infinity" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white;"/>
        </VBox>

        <HBox spacing="10">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Check-In" style="-fx-text-fill: #a0a0c0; -fx-font-size: 11;"/>
                <DatePicker fx:id="dpStartDate" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Check-Out" style="-fx-text-fill: #a0a0c0; -fx-font-size: 11;"/>
                <DatePicker fx:id="dpEndDate" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <Label text="* Any overlapping dates will be rejected." style="-fx-text-fill: #555; -fx-font-size: 10;"/>

        <Button text="➕ Book Reservation" onAction="#handleBookReservation" maxWidth="Infinity"
                style="-fx-background-color: #00d2ff; -fx-text-fill: #0a0a1a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
    </VBox>

    <!-- RIGHT: Table -->
    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Upcoming Bookings" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>

        <TableView fx:id="tblReservations" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colResId" text="Res #" prefWidth="60">
                    <cellValueFactory><PropertyValueFactory property="reservationId"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colGuestName" text="Guest Name" prefWidth="140">
                    <cellValueFactory><PropertyValueFactory property="guestName"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colPhone" text="Phone" prefWidth="110">
                    <cellValueFactory><PropertyValueFactory property="guestPhone"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colRoomNum" text="Room" prefWidth="65">
                    <cellValueFactory><PropertyValueFactory property="roomNumber"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colRoomType" text="Type" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="roomType"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colStart" text="Check-In" prefWidth="95">
                    <cellValueFactory><PropertyValueFactory property="startDate"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colEnd" text="Check-Out" prefWidth="95">
                    <cellValueFactory><PropertyValueFactory property="endDate"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="90">
                    <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <Button text="🚫 Cancel Selected Booking" onAction="#handleCancelReservation"
                    style="-fx-background-color: #ff5252; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

</HBox>
